\chapter{Proof sketches and derivations}
\label{app:proofs}

This appendix collects the mathematical statements used in the main text with proof sketches at the level
of rigor we actually rely on --- enough to see why each claim is true and where its assumptions bind, with
pointers to full treatments; nothing here pretends to be a complete proof.

\section{Marked-point-process factorization}
\label{app:proofs-mpp}

\begin{proposition}
\label{prop:app-mpp}
Let $N$ be a marked point process on $[0,T]$ with marks in $\mathcal{M}$ and internal history $\Hist_t$. If
$N$ admits a conditional intensity $\lambda(t, m \mid \Hist_t)$, then it factorizes as
$\lambda(t, m \mid \Hist_t) = \lambda_g(t \mid \Hist_t)\, f(m \mid t, \Hist_t)$, where $\lambda_g$ is the
ground intensity and $f(\cdot \mid t, \Hist_t)$ is a probability kernel on $\mathcal{M}$. The log-likelihood
correspondingly splits into a ground term and a mark term.
\end{proposition}

\begin{proof}[Sketch]
Define $\lambda_g(t \mid \Hist_t) = \int_{\mathcal{M}} \lambda(t, m \mid \Hist_t)\, \nu(\dd m)$, the
conditional intensity of the ground process (event times ignoring marks), and set
$f(m \mid t, \Hist_t) = \lambda(t, m \mid \Hist_t) / \lambda_g(t \mid \Hist_t)$ wherever the denominator is
positive. By construction $f$ integrates to one and the factorization holds pointwise. Substituting into
the point-process likelihood, the compensator $\int_0^T \lambda_g\,\dd t$ involves only the ground component
because $f$ integrates out, so marks enter only through $\sum_i \log f(m_i \mid t_i, \Hist_{t_i})$. This is
why Chapter~\ref{ch:hawkes} may fit timing and marks in two stages without loss when the parameters are
variation-independent. See \cite[Ch.~6--7]{daley2003} for the full construction.
\end{proof}

\section{The MBPP Volterra equation}
\label{app:proofs-volterra}

\begin{proposition}
\label{prop:app-volterra}
Let $N$ be a Hawkes process with intensity $\lambda(t) = \mu(t) + \int_0^t \varphi(t-s)\,\dd N(s)$, with
$\mu \ge 0$ locally bounded and $\varphi \ge 0$ integrable. Then $h(t) = \E[\lambda(t)]$ satisfies the
Volterra equation of the second kind $h(t) = \mu(t) + \int_0^t \varphi(t-s)\, h(s)\,\dd s$, the object the
MBPP layer of Chapter~\ref{ch:censored} solves.
\end{proposition}

\begin{proof}[Sketch]
Write $\dd N(s) = \lambda(s)\,\dd s + \dd M(s)$ with $M$ the martingale part of the semimartingale
decomposition of $N$. Then
$\lambda(t) = \mu(t) + \int_0^t \varphi(t-s)\lambda(s)\,\dd s + \int_0^t \varphi(t-s)\,\dd M(s)$. Taking
expectations, the martingale integral vanishes because $\varphi(t-\cdot)$ is deterministic and locally
bounded, so its stochastic integral against $\dd M$ has zero mean; Fubini exchanges expectation and the
Lebesgue integral, giving the stated equation. Uniqueness follows from Picard iteration for Volterra
kernels with $\|\varphi\|_{L^1} < 1$ on compacts. The PINO operator of Chapter~\ref{ch:selection} learns
the solution map $(\mu, \varphi) \mapsto h$ of exactly this equation.
\end{proof}

\section{Concavity of the log-link Poisson GLM}
\label{app:proofs-concave}

\begin{proposition}
\label{prop:app-concave}
For counts $y_i$ with rates $\lambda_i = \exp(x_i^\top \beta)$ and exposures $e_i > 0$, the Poisson
log-likelihood $\ell(\beta) = \sum_i \{ y_i (x_i^\top\beta + \log e_i) - e_i \exp(x_i^\top \beta) \} + c$ is
concave in $\beta$, strictly so when the design matrix has full column rank.
\end{proposition}

\begin{proof}[Sketch]
This is the exponential-family Hessian argument:
$\nabla^2 \ell(\beta) = -\sum_i e_i \exp(x_i^\top\beta)\, x_i x_i^\top$, a nonpositive-definite sum of
rank-one matrices with positive weights, negative definite iff the $x_i$ span $\mathbb{R}^p$. Hence any
stationary point is the global maximizer and Fisher scoring in Chapter~\ref{ch:poisson} is globally well
behaved. The argument does not protect dynamics: with lagged endogenous counts in $x_i$ the likelihood
remains concave conditionally on observed lags, but the implied system need not be stable --- the
metastability episode of Chapter~\ref{ch:selection}, with theory in \cite{fokianos2009,bremaud1996}.
\end{proof}

\section{Sampled-softmax consistency for the conditional logit}
\label{app:proofs-softmax}

\begin{proposition}
\label{prop:app-softmax}
In the conditional logit \cite{mcfadden1974} with choice set $\RS_t$ and utilities $w^\top z_j$, suppose
each event's estimation set $D_t$ consists of the chosen alternative plus $J-1$ alternatives drawn uniformly
without replacement from $\RS_t$. Then the score of the sampled likelihood
$\sum_t \log\{ \exp(w^\top z_{c_t}) / \sum_{j \in D_t} \exp(w^\top z_j) \}$ has zero expectation at the true
$w$, and the maximizer is consistent.
\end{proposition}

\begin{proof}[Sketch]
Under uniform sampling the probability of drawing the set $D_t$ is the same regardless of which element of
$D_t$ was chosen (McFadden's uniform conditioning property). Conditioning the choice on
$\{c_t \in D_t, D_t\}$ therefore yields a probability of exactly logit form restricted to $D_t$, with no
correction terms --- the sampling weights cancel in the ratio. The sampled log-likelihood is thus a valid
conditional likelihood, its score is a martingale difference with zero mean at the truth, and standard
M-estimation gives consistency, at an efficiency cost decreasing in $J$. Non-uniform sampling requires the
$\log q_j$ correction; we avoid it by sampling uniformly with $J = 64$ in Chapter~\ref{ch:hawkes}.
\end{proof}

\section{Integrated-entrant utility}
\label{app:proofs-entrant}

\begin{lemma}
\label{lem:app-entrant}
Let candidate features satisfy $z \sim \mathcal{N}(\mu, \Sigma)$ and let the utility be linear,
$u = w^\top z$. Then $\log \E[\exp(w^\top z)] = w^\top \mu + \tfrac{1}{2} w^\top \Sigma\, w$. Consequently a
pool of $N_{\mathrm{pool}}$ i.i.d.\ unobserved entrants contributes to the softmax denominator, in
expectation, one composite alternative with utility
$\mathrm{ASC} = \log N_{\mathrm{pool}} + w^\top \mu + \tfrac{1}{2} w^\top \Sigma\, w$.
\end{lemma}

\begin{proof}[Sketch]
The first display is the Gaussian moment generating function: $w^\top z$ is univariate normal with mean
$w^\top\mu$ and variance $w^\top\Sigma w$, and $\E[e^X] = e^{m + v/2}$ for $X \sim \mathcal{N}(m, v)$. For
the pool, $\E[\sum_{j=1}^{N_{\mathrm{pool}}} e^{w^\top z_j}] = N_{\mathrm{pool}}\, \E[e^{w^\top z}]$ by
exchangeability; replacing the random sum by its expectation inside the log denominator is a first-order
approximation with $O(1/N_{\mathrm{pool}})$ error by a delta-method argument, adequate for the pool sizes of
Chapter~\ref{ch:hawkes}.
\end{proof}

\begin{remark}
\label{rem:app-entrant-ident}
The decomposition shows that $N_{\mathrm{pool}}$ and the entrant mean utility $w^\top\mu$ are \emph{not
separately identifiable} from a constant ASC: any pair on the same level set fits identically.
Identification requires $N_{\mathrm{pool}}$ to vary over time with known (or modelled) variation --- for
example universe-expansion waves --- entering as an offset $\log N_{\mathrm{pool},t}$. This is why
Chapter~\ref{ch:selection} instructs recalibrating the newcomer ASC whenever the pool definition changes:
the fitted 6.856 (regime A) is a statement about the pool as much as about entrant quality.
\end{remark}

\section{The time-rescaling theorem}
\label{app:proofs-rescaling}

\begin{theorem}
\label{thm:app-rescaling}
Let $N$ have conditional intensity $\lambda(t \mid \Hist_t) > 0$ with compensator
$\Lambda(t) = \int_0^t \lambda(s \mid \Hist_s)\,\dd s \to \infty$. Then the transformed times
$\tau_i = \Lambda(t_i)$ form a unit-rate Poisson process; equivalently the increments
$\tau_i - \tau_{i-1}$ are i.i.d.\ standard exponential.
\end{theorem}

\begin{proof}[Sketch]
The time-changed process $N(\Lambda^{-1}(\tau))$ has compensator $\tau$ by the change-of-time formula for
point-process compensators, and a counting process with deterministic compensator $\tau$ is unit-rate
Poisson by Watanabe's martingale characterization; see \cite[Ch.~7]{daley2003}. The practical use,
following \cite{ogata1988}, is residual analysis: transform observed times through the fitted
$\hat\Lambda$ and test the increments for unit exponentiality (QQ plots, Kolmogorov--Smirnov) and
independence (autocorrelation of transformed interarrivals). Every event-time model in
Chapter~\ref{ch:hawkes}, and every rung of the Poisson-null ladder in Chapter~\ref{ch:selection}, reports
these residuals.
\end{proof}

